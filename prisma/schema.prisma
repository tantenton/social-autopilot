generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  platforms Platform[]
  campaigns CampaignSchedule[]
  accounts  Account[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires       DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Platform {
  id            String   @id @default(cuid())
  name          PlatformName
  userId        String
  credentials   Json
  status        PlatformStatus
  connectedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlatformName {
  X
  THREADS
  FB
  IG
  TIKTOK
  YOUTUBE
}

enum PlatformStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model ContentIdea {
  id             String   @id @default(cuid())
  topic          String
  viralityScore  Int      @default(0)
  sentiment      String?
  trendingSince  DateTime?
  platform       PlatformName?
  metadata       Json?
  pieces         ContentPiece[]
  posts          Post[] @relation("idea_posts")
}

model ContentPiece {
  id          String   @id @default(cuid())
  ideaId      String
  type        ContentType
  prompt      String?
  assetUrl    String?
  generatedAt DateTime @default(now())
  idea        ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  posts       Post[] @relation("piece_posts")
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
}

model Post {
  id              String   @id @default(cuid())
  contentId       String?
  ideaId          String?
  platform        PlatformName
  scheduledAt     DateTime?
  postedAt        DateTime?
  status          PostStatus
  platformPostId  String?
  metrics         Json?
  content         ContentPiece? @relation("piece_posts", fields: [contentId], references: [id], onDelete: SetNull)
  idea            ContentIdea? @relation("idea_posts", fields: [ideaId], references: [id], onDelete: SetNull)
}

enum PostStatus {
  QUEUED
  POSTING
  PUBLISHED
  FAILED
}

model CampaignSchedule {
  id            String   @id @default(cuid())
  userId        String
  cronExpression String
  platforms     String[]
  isActive      Boolean  @default(true)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
