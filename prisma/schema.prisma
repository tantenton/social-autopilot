generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PlatformName {
  X
  THREADS
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum PlatformStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
}

enum PostStatus {
  QUEUED
  POSTING
  PUBLISHED
  FAILED
}

enum Tone {
  CASUAL
  PROFESSIONAL
  HUMOROUS
}

// ─── NextAuth Models ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ───────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]

  platforms  ConnectedPlatform[]
  ideas      ContentIdea[]
  campaigns  CampaignSchedule[]
}

model ConnectedPlatform {
  id          String         @id @default(cuid())
  userId      String
  name        PlatformName
  status      PlatformStatus @default(CONNECTED)
  credentials Json
  connectedAt DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@unique([userId, name])
}

model ContentIdea {
  id            String        @id @default(cuid())
  userId        String
  topic         String
  viralityScore Int           @default(0)
  sentiment     String?
  trendingSince DateTime?
  platforms     PlatformName[]
  metadata      Json?
  createdAt     DateTime      @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pieces ContentPiece[]
}

model ContentPiece {
  id               String       @id @default(cuid())
  ideaId           String
  platform         PlatformName
  type             ContentType
  tone             Tone         @default(CASUAL)
  prompt           String?
  text             String?      @db.Text
  assetUrl         String?
  rationale        String?      @db.Text
  viralityEstimate Int?
  generatedAt      DateTime     @default(now())

  idea  ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  posts Post[]
}

model Post {
  id             String       @id @default(cuid())
  contentId      String
  platformId     String
  platform       PlatformName
  scheduledAt    DateTime?
  postedAt       DateTime?
  status         PostStatus   @default(QUEUED)
  platformPostId String?
  platformUrl    String?
  metrics        Json?
  errorMessage   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  content           ContentPiece      @relation(fields: [contentId], references: [id])
  connectedPlatform ConnectedPlatform @relation(fields: [platformId], references: [id])
}

model CampaignSchedule {
  id             String         @id @default(cuid())
  userId         String
  name           String
  cronExpression String
  platforms      PlatformName[]
  topics         String[]
  tone           Tone           @default(CASUAL)
  isActive       Boolean        @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
